# .gitignore

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Project-specific generated content
results/figures/*.png
results/figures/*.pdf
results/outputs/*

# Keep directories but ignore generated files
!results/figures/.gitkeep
!results/outputs/.gitkeep
!results/summaries/.gitkeep

# Data directories
# Keep the folder structure but ignore large or local-only files that should not be committed.
data/raw/*
data/processed/*
data/metadata/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep

# General cache and logs
*.log
